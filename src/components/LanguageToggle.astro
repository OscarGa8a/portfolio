---
import type { Locale } from '../i18n/index';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: Locale;
  mobile?: boolean;
}
const { lang, mobile = false } = Astro.props;
const dest = lang === 'es' ? '/en/' : '/';
const label = lang === 'es' ? 'EN' : 'ES';
const accessibleLabel = lang === 'es' ? 'Cambiar el idioma a inglés' : 'Switch language to Spanish';
---
<a
  href={dest}
  class:list={[
    'text-xs font-bold text-text-sec hover:text-text-main transition-all duration-100 ease-out active:scale-95 bg-white/5 border border-white/10 flex items-center gap-1.5',
    mobile ? 'drawer-link w-full px-3 py-3 rounded-lg' : 'px-3 py-1.5 rounded-md',
  ]}
  aria-label={accessibleLabel}
  hreflang={lang === 'es' ? 'en' : 'es'}
>
  <Icon name="ph:translate" class="w-3.5 h-3.5 text-accent" />
  {mobile ? accessibleLabel : label}
</a>
