---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import Section from './Section.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const steps = [
  { title: 'process_step1_title', desc: 'process_step1_desc' },
  { title: 'process_step2_title', desc: 'process_step2_desc' },
  { title: 'process_step3_title', desc: 'process_step3_desc' },
  { title: 'process_step4_title', desc: 'process_step4_desc' },
];
---
<Section id="proceso" padding="py-24">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl mb-16">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-5 text-text-main">{t(lang, 'process_title')}</h2>
      <p class="text-text-sec text-lg leading-relaxed">{t(lang, 'process_subtitle')}</p>
    </div>

    <!-- 4-step progressive editorial grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step, i) => (
        <div class="border-t border-white/10 pt-6 flex flex-col justify-between group hover:border-accent/40 transition-colors duration-300">
          <div>
            <div class="font-mono text-xs font-bold text-accent tracking-widest mb-4">
              0{i + 1}
            </div>
            <h3 class="font-display text-lg font-bold text-text-main mb-3 group-hover:text-accent transition-colors duration-200">
              {t(lang, step.title)}
            </h3>
            <p class="text-sm text-text-sec leading-relaxed">
              {t(lang, step.desc)}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>
