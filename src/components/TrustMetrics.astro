---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

// Each metric now leads with a real number for parallel visual weight.
// Values are conservative and derived from the site's own content — adjust to the real figures.
const metrics = [
  { num: '5', plus: true,  label: t(lang, 'trust_years_label'),     desc: t(lang, 'trust_years_desc') },
  { num: '7', plus: true,  label: t(lang, 'trust_projects_title'),  desc: t(lang, 'trust_projects_desc') },
  { num: '6', plus: true,  label: t(lang, 'trust_solutions_title'), desc: t(lang, 'trust_solutions_desc') },
  { num: '2', plus: false, label: t(lang, 'trust_responsive_title'), desc: t(lang, 'trust_responsive_desc') },
];
---
<section class="py-14 bg-bg-sec/40 border-y border-white/5 reveal">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 lg:gap-x-0 lg:divide-x lg:divide-white/10">
      {metrics.map((m) => (
        <div class="lg:px-8 lg:first:pl-0">
          <div class="font-display text-4xl font-bold text-text-main leading-none">
            {m.num}{m.plus && <span class="text-accent">+</span>}
          </div>
          <div class="text-base font-medium text-text-sec mt-2">{m.label}</div>
          <p class="text-sm text-text-sec/80 mt-3 leading-relaxed">{m.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
