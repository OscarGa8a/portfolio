---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const metrics = [
  { eyebrow: t(lang, 'trust_since_label'), title: t(lang, 'trust_since_title'), desc: t(lang, 'trust_since_desc') },
  { eyebrow: t(lang, 'trust_scope_label'), title: t(lang, 'trust_scope_title'), desc: t(lang, 'trust_scope_desc') },
  { eyebrow: t(lang, 'trust_reach_label'), title: t(lang, 'trust_reach_title'), desc: t(lang, 'trust_reach_desc') },
];
---
<section class="py-14 bg-bg-sec/40 border-y border-white/5 reveal">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <h2 class="sr-only">{t(lang, 'trust_heading')}</h2>
    <div class="grid md:grid-cols-3 gap-x-8 gap-y-10 md:divide-x md:divide-white/10">
      {metrics.map((m) => (
        <div class="md:px-8 md:first:pl-0 flex flex-col justify-start">
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-accent mb-2.5">{m.eyebrow}</p>
          <p class="font-display text-xl font-bold text-text-main leading-tight">{m.title}</p>
          <p class="text-sm text-text-sec mt-2.5 leading-relaxed">{m.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
