---
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { contact } from '../config/site';
import { CldImage } from 'astro-cloudinary';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const tags = [
  'about_tag_business',
  'about_tag_strategy',
  'about_tag_experience',
  'about_tag_custom',
];
---
<Section id="sobre-mi" bg="bg-bg-sec/30 border-y border-white/5" padding="py-24">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center gap-16">
    <!-- Profile card -->
    <div class="w-full lg:w-5/12 flex justify-center">
      <div class="relative w-72 sm:w-80 h-96 premium-card rounded-2xl flex flex-col items-center justify-center border border-white/10 shadow-2xl shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] overflow-hidden group">
        <div class="absolute -top-8 -right-8 w-36 h-36 bg-accent/15 rounded-full blur-[48px] pointer-events-none"></div>

        <CldImage
          src="oscar_dev/oscar-dev_sef1wl"
          width={640}
          height={768}
          alt={lang === 'es' ? 'Retrato ilustrado de Oscar García, creador de Oscar Dev' : 'Illustrated portrait of Oscar García, creator of Oscar Dev'}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
          loading="lazy"
        />
        <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-bg-main via-bg-main/80 to-transparent"></div>
        <div class="absolute bottom-6 flex gap-2.5 z-10">
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-accent hover:text-bg-main border border-white/10 hover:border-accent transition-all duration-150 ease-out active:scale-95 flex items-center justify-center text-text-sec">
            <Icon name="ph:linkedin-logo" class="w-4 h-4" />
          </a>
          <a href={contact.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-accent hover:text-bg-main border border-white/10 hover:border-accent transition-all duration-150 ease-out active:scale-95 flex items-center justify-center text-text-sec">
            <Icon name="ph:github-logo" class="w-4 h-4" />
          </a>
          <a href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-accent hover:text-bg-main border border-white/10 hover:border-accent transition-all duration-150 ease-out active:scale-95 flex items-center justify-center text-text-sec">
            <Icon name="ph:instagram-logo" class="w-4 h-4" />
          </a>
          <a href={contact.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-accent hover:text-bg-main border border-white/10 hover:border-accent transition-all duration-150 ease-out active:scale-95 flex items-center justify-center text-text-sec">
            <Icon name="ph:tiktok-logo" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="w-full lg:w-7/12">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3">{t(lang, 'about_kicker')}</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-6 text-text-main">{t(lang, 'about_title')}</h2>
      <p class="text-text-sec text-lg leading-relaxed mb-8">{t(lang, 'about_body')}</p>

      <div class="flex flex-wrap gap-2.5">
        {tags.map((tag) => (
          <span class="bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-lg text-xs font-medium text-text-sec hover:border-accent/40 hover:text-text-main transition-colors">{t(lang, tag)}</span>
        ))}
      </div>
    </div>
  </div>
</Section>
