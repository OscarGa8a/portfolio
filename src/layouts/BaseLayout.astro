---
import '../styles/global.css';
import RevealObserver from '../components/RevealObserver.astro';
import Analytics from '../components/Analytics.astro';
import { siteUrl, author, contact } from '../config/site';

interface Props {
  lang: 'es' | 'en';
  title?: string;
  description?: string;
}
const {
  lang,
  title = lang === 'es'
    ? 'Oscar Dev | Desarrollo web para negocios reales'
    : 'Oscar Dev | Web development for real businesses',
  description = lang === 'es'
    ? 'Webs, tiendas online, apps y plataformas a medida para negocios que necesitan más claridad, orden y control.'
    : 'Websites, online stores, apps and custom platforms for businesses that need more clarity, order and control.',
} = Astro.props;

// Absolute URLs (canonical, OG) derived from the single siteUrl source.
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/og-image.png', siteUrl).href;
const esHref = new URL('/', siteUrl).href;
const enHref = new URL('/en/', siteUrl).href;
const ogAlt = lang === 'es'
  ? 'Oscar Dev — soluciones digitales para negocios reales'
  : 'Oscar Dev — digital solutions for real businesses';

const services = lang === 'es'
  ? ['Sitios web profesionales', 'Tiendas online', 'Aplicaciones web y móviles', 'Plataformas a medida']
  : ['Professional websites', 'Online stores', 'Web and mobile apps', 'Custom platforms'];

// Structured data: who Oscar is + what he offers. Helps Google show rich results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: author.name,
      url: siteUrl,
      jobTitle: author.jobTitle[lang],
      worksFor: { '@id': `${siteUrl}/#service` },
      email: author.email,
      telephone: author.phone,
      address: { '@type': 'PostalAddress', addressCountry: author.countryCode },
      sameAs: [contact.linkedin, contact.github],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#service`,
      name: author.brand,
      url: siteUrl,
      image: ogImage,
      description,
      provider: { '@id': `${siteUrl}/#person` },
      inLanguage: [lang, lang === 'es' ? 'en' : 'es'],
      areaServed: ['CO', 'US'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: lang === 'es' ? 'Soluciones digitales' : 'Digital solutions',
        itemListElement: services.map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: author.brand,
      url: siteUrl,
      inLanguage: ['es', 'en'],
    },
  ],
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#121214" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={author.brand} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_CO'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#contenido-principal">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <slot />
    <RevealObserver />
    <Analytics />
  </body>
</html>
