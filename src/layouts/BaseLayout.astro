---
import '../styles/global.css';
import RevealObserver from '../components/RevealObserver.astro';
import { siteUrl, author, contact } from '../config/site';

interface Props {
  lang: 'es' | 'en';
  title?: string;
  description?: string;
}
const {
  lang,
  title = 'Oscar García Dev | Freelance Web Developer',
  description = lang === 'es'
    ? 'Desarrollador web freelance: sitios web, e-commerce, apps y plataformas a medida para negocios reales.'
    : 'Freelance web developer: websites, e-commerce, apps and custom platforms for real businesses.',
} = Astro.props;

// Absolute URLs (canonical, OG) derived from the single siteUrl source.
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/og-image.png', siteUrl).href;
const esHref = new URL('/', siteUrl).href;
const enHref = new URL('/en/', siteUrl).href;

// Structured data: who Oscar is + what he offers. Helps Google show rich results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: author.name,
      url: siteUrl,
      jobTitle: author.jobTitle[lang],
      email: author.email,
      telephone: author.phone,
      address: { '@type': 'PostalAddress', addressCountry: author.countryCode },
      sameAs: [contact.linkedin, contact.github],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#service`,
      name: author.brand,
      url: siteUrl,
      image: ogImage,
      description,
      provider: { '@id': `${siteUrl}/#person` },
      areaServed: ['CO', 'US'],
      knowsAbout: [
        'Web Development',
        'E-commerce',
        'Web & Mobile Apps',
        'Custom Platforms',
      ],
    },
  ],
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={author.brand} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_CO'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="antialiased">
    <slot />
    <RevealObserver />
  </body>
</html>
